  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src --watch-path=templates src/server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "weather",
    "express",
    "handlebars",
    "open-meteo"
  ],
